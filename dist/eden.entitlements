<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Required by the Hypervisor.framework CPU backend. Without it
        hv_vm_create returns HV_DENIED and there is no way to recover at run
        time, so the backend reports itself unavailable and the emulator falls
        back to dynarmic.
    -->
    <key>com.apple.security.hypervisor</key>
    <true/>

    <!--
        dynarmic writes and then executes recompiled guest code, which the
        hardened runtime forbids by default.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- MoltenVK and the Qt frameworks ship inside the bundle. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
