From: crueter <crueter@eden-emu.dev>
Date: Fri, 20 Nov 2026 22:40:49 -0500
Subject: [PATCH] fix clang cl cross comp

---
 libs/context/CMakeLists.txt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/libs/context/CMakeLists.txt b/libs/context/CMakeLists.txt
index e0448b1f..72c811c0 100644
--- a/libs/context/CMakeLists.txt
+++ b/libs/context/CMakeLists.txt
@@ -275,3 +275,9 @@ if(BUILD_TESTING AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/test/CMakeLists.txt")
   add_subdirectory(test)

 endif()
+
+# clang-cl expects /Fo
+if (CLANG_CL_CROSSCOMPILING)
+    set(CMAKE_ASM_MASM_COMPILE_OBJECT "<CMAKE_ASM_MASM_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -c /Fo<OBJECT> <SOURCE>")
+    set(CMAKE_ASM_MARMASM_COMPILE_OBJECT "<CMAKE_ASM_MARMASM_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -c /Fo<OBJECT> <SOURCE>")
+endif()
\ No newline at end of file
